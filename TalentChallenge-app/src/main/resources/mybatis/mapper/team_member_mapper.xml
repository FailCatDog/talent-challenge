<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.hgy.infrastructure.persistent.dao.TeamMemberDao">

    <insert id="insert" parameterType="cn.hgy.infrastructure.persistent.po.TeamMember" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO team_member (team_id, user_id, role, join_time)
        VALUES (#{teamId}, #{userId}, #{role}, #{joinTime})
    </insert>

    <select id="existsByTeamIdAndUserId" resultType="int">
        SELECT COUNT(1) FROM team_member
        WHERE team_id = #{teamId} AND user_id = #{userId}
    </select>

    <resultMap id="TeamMemberItemResultMap" type="cn.hgy.api.dto.TeamMemberItemDTO">
        <result column="user_id" property="userId" jdbcType="VARCHAR"/>
        <result column="nickname" property="nickname" jdbcType="VARCHAR"/>
        <result column="avatar_url" property="avatarUrl" jdbcType="VARCHAR"/>
        <result column="role" property="role" jdbcType="VARCHAR"/>
    </resultMap>

    <select id="selectMembersByTeamId" resultMap="TeamMemberItemResultMap">
        SELECT
            tm.user_id,
            u.nickname,
            u.avatar_url,
            tm.role
        FROM team_member tm
        LEFT JOIN user u ON tm.user_id = u.user_id
        WHERE tm.team_id = #{teamId}
        ORDER BY FIELD(tm.role, 'leader', 'member'), tm.join_time ASC
    </select>

</mapper>
